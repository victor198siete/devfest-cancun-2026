# Puerto de la API
PORT=3015

# Proyecto y region de Google Cloud donde corre Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Nombre exacto del modelo (nunca un alias tipo "-latest")
GEMINI_MODEL=gemini-3.8-flash

# Idioma del aviso para redes: es | en
AVISO_IDIOMA=es

# Reportes por minuto y por IP en POST /reportes (en la instancia compartida de respaldo, subirlo: toda la sala sale por la misma IP del Wi-Fi)
LIMITE_POR_MINUTO=20
