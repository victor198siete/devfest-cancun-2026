{
  "expo": {
    "name": "Reporta tu mascota",
    "slug": "devfest-reporta-mascota",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Necesitamos tu galería para que elijas la foto de la mascota.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para indicar dónde viste a la mascota."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "292b66c8-3260-4737-95e5-8a4561064a9d"
      }
    },
    "plugins": [
      "@ng-native/metro/app.plugin.cjs",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos tu galería para que elijas la foto de la mascota."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para indicar dónde viste a la mascota.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "owner": "horizontech-vic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/292b66c8-3260-4737-95e5-8a4561064a9d"
    }
  }
}
